{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bitly BSDs API",
    "version": "4.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "BSDs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get BSDs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-ssl.bitly.com/v4/bsds"
          },
          "docs": "Fetch all Branded Short Domains"
        }
      ]
    }
  ],
  "bundled": true
}